NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Fill this in once your repo's GitHub Pages site is live (Settings -> Pages).
# e.g. https://yourusername.github.io/your-repo-name
SITE_BASE_URL=

# "draft" = writes to _drafts/ (nothing goes live until you review + move it).
# "publish" = writes straight to _posts/ (live immediately).
POST_STATUS=draft

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ARTICLES_PER_RUN=1
